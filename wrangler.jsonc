{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickem-club",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The database for accounts, leagues and picks. Cloudflare creates it on the first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "pickem-club" }
  ],
  // Refresh NFL scores every 10 minutes.
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
