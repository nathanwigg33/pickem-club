{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pickem-club",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The database for accounts, leagues and picks. (It keeps its original name, pickem-club.)
  "d1_databases": [
    // database_id pins the app to the existing database so accounts, leagues and picks carry over.
    { "binding": "DB", "database_name": "pickem-club", "database_id": "a35e83c9-3bae-493b-9e3d-80505d6f0f58" }
  ],
  // Refresh NFL scores every 10 minutes.
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
